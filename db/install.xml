<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="question/type/labcalc/db" VERSION="20261111" COMMENT="XMLDB file for Moodle question/type/labcalc"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="qtype_labcalc_options" COMMENT="Options for Lab calculation questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Foreign key references question.id."/>
        <FIELD NAME="formula" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Instructor formula, using {name} for each experimental value."/>
        <FIELD NAME="resultlabel" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Label shown next to the calculated value input."/>
        <FIELD NAME="resultunit" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Unit shown after the calculated value input."/>
        <FIELD NAME="tolerance" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Tolerance for full marks."/>
        <FIELD NAME="tolerancetype" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1 = relative (percent), 2 = absolute."/>
        <FIELD NAME="partialtolerance" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Optional wider tolerance for partial credit. Blank = none."/>
        <FIELD NAME="partialfraction" TYPE="number" LENGTH="12" NOTNULL="true" DEFAULT="0.5" SEQUENCE="false" DECIMALS="7" COMMENT="Fraction awarded within the partial credit tolerance."/>
        <FIELD NAME="displaysigfigs" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="4" SEQUENCE="false" COMMENT="Significant figures used when showing the expected value."/>
        <FIELD NAME="showexpected" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Show the value expected from the student's own data in feedback."/>
        <FIELD NAME="showformula" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Show the formula in feedback."/>
        <FIELD NAME="correctfeedback" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="correctfeedbackformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="partiallycorrectfeedback" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="partiallycorrectfeedbackformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="incorrectfeedback" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="incorrectfeedbackformat" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign-unique" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="qtype_labcalc_vars" COMMENT="Experimental values the student must enter for a Lab calculation question">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Foreign key references question.id."/>
        <FIELD NAME="name" TYPE="char" LENGTH="40" NOTNULL="true" SEQUENCE="false" COMMENT="Variable name used in the formula as {name}."/>
        <FIELD NAME="label" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Label shown to students."/>
        <FIELD NAME="unit" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Unit shown to students."/>
        <FIELD NAME="rangemin" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Optional minimum acceptable value. Blank = no limit."/>
        <FIELD NAME="rangemax" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Optional maximum acceptable value. Blank = no limit."/>
        <FIELD NAME="samplevalue" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Typical value, used to check the formula and for previews."/>
        <FIELD NAME="sortorder" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="questionid" TYPE="foreign" FIELDS="questionid" REFTABLE="question" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
